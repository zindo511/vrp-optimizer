# ═══════════════════════════════════════════════════════════════════
# VRP Optimizer — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# PostgreSQL
DB_USERNAME=vrp_admin
DB_PASSWORD=change_me_in_production

# JWT Secret (must be at least 256 bits = 32 characters)
SECRET_KEY=myDefaultSuperSecretKeyForJWT256bit!!

# OSRM routing engine (default: public, prod: self-hosted)
OSRM_BASE_URL=https://router.project-osrm.org
